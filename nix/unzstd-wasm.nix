# zstd's reference decoder compiled to wasm, for the page and its
# decode workers (site/js/unzstd.js). The C is zstd's own, from the
# release nixpkgs builds its zstd from, behind a small wrapper
# (wasm/unzstd/unzstd.c) that streams an archive through it a piece at
# a time with no allocator.
#
# Built freestanding, with nixpkgs' clang and lld for wasm32: no C
# library, no Emscripten. The decoder calls three libc functions,
# which are the compiler's builtins, and declares an allocator it is
# never made to use; the headers in wasm/unzstd/include/ say how each
# is met. The module imports nothing.
#
# Two files come out: unzstd.wasm, and unzstd-wasm.js, the same bytes
# as a classic script the site carries under js/ (site/js/unzstd.js
# says why a script). The script opens with zstd's license, which asks
# to travel with the binary.
{ pkgs }:
let
  llvm = pkgs.llvmPackages;
  zstd = pkgs.zstd.src;

  # The decoder's half of zstd: the files zstd's own single-file
  # decoder gathers (build/single_file_libs/zstddeclib-in.c), and
  # xxhash.c, which that file inlines instead.
  sources = map (file: "${zstd}/lib/${file}") [
    "common/entropy_common.c"
    "common/error_private.c"
    "common/fse_decompress.c"
    "common/xxhash.c"
    "common/zstd_common.c"
    "decompress/huf_decompress.c"
    "decompress/zstd_ddict.c"
    "decompress/zstd_decompress.c"
    "decompress/zstd_decompress_block.c"
  ];

  # The stack the decoder runs on. It sits below the static data
  # (--stack-first), so running off its end traps rather than writing
  # over the buffers.
  stackSize = 64 * 1024;
in
# lld is on the path rather than named, because clang finds wasm-ld
# there and nowhere else. binaryen is named and kept off the path: clang
# runs any wasm-opt it finds after linking, and the one run here should
# be the only one.
pkgs.runCommand "unzstd-wasm" { nativeBuildInputs = [ llvm.lld ]; } ''
  mkdir -p $out

  # zstd's settings for a decoder alone: no x86 assembly, no frames from
  # before zstd 0.8, no tracing hooks, no debug checks.
  ${llvm.clang-unwrapped}/bin/clang \
    --target=wasm32 -nostdlib -ffreestanding -O3 -mbulk-memory \
    -DZSTD_DISABLE_ASM -DZSTD_LEGACY_SUPPORT=0 -DZSTD_TRACE=0 -DDEBUGLEVEL=0 \
    -I${../wasm/unzstd/include} -I${zstd}/lib -I${zstd}/lib/common \
    -Wl,--no-entry -Wl,--stack-first -Wl,-z,stack-size=${toString stackSize} \
    ${../wasm/unzstd/unzstd.c} ${pkgs.lib.concatStringsSep " " sources} \
    -o unzstd.wasm
  ${pkgs.binaryen}/bin/wasm-opt -O3 --strip-debug --strip-producers \
    unzstd.wasm -o $out/unzstd.wasm

  {
    sed 's|^|// |; s| *$||' ${zstd}/LICENSE
    echo
    echo "// zstd's decoder compiled to wasm (nix/unzstd-wasm.nix), as base64,"
    echo "// for site/js/unzstd.js. Generated by the build."
    printf 'globalThis.UNZSTD_WASM = "%s";\n' "$(base64 -w0 $out/unzstd.wasm)"
  } > $out/unzstd-wasm.js
''
