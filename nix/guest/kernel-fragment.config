# Appended to the vendored qemu-wasm config before olddefconfig.
#
# The fork's examples boot from an ext4 disk image, so their config
# never enabled initramfs loading; trynix boots from an initramfs and
# mounts the store over 9p, no block device at all.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# The rest of this file is subtraction. The vendored config is close to
# a defconfig — 813 enabled options, drivers for hardware this guest
# cannot have — and every one of them is boot-time device probing an
# emulator has to execute, plus bytes in a bzImage every visitor
# downloads. The machine is fixed and known: virtio-pci over 9p, a
# serial console, an initramfs. Kconfig drops the dependents.
#
# Whole subsystems with no device behind them. Networking stays on
# (CONFIG_NET) because 9p is a network filesystem, but no NIC driver is
# reachable when the page starts QEMU with -nic none.
# CONFIG_WLAN is not set
# CONFIG_ETHERNET is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_HID is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_I2C is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_MEDIA_SUPPORT is not set

# No display: the console is ttyS0 and the page draws the terminal.
# CONFIG_FB is not set
# CONFIG_DRM is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_LOGO is not set

# No disks, so no disk filesystems; the root is the initramfs and the
# store arrives over 9p.
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NFS_FS is not set

# Tracing and debug machinery nothing here reads.
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_DEBUG_KERNEL is not set
