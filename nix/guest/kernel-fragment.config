# Appended to the vendored qemu-wasm config before olddefconfig.
#
# The fork's examples boot from an ext4 disk image, so their config
# never enabled initramfs loading; trynix boots from an initramfs and
# mounts the store over 9p, no block device at all.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# The rest of this file is subtraction. The vendored config is close to
# a defconfig — 813 enabled options, drivers for hardware this guest
# cannot have — and every one of them is boot-time device probing an
# emulator has to execute, plus bytes in a bzImage every visitor
# downloads. The machine is fixed and known: virtio-pci over 9p, a
# serial console, an initramfs. Kconfig drops the dependents.
#
# Whole subsystems with no device behind them. Networking stays on
# (CONFIG_NET) because 9p is a network filesystem, but no NIC driver is
# reachable when the page starts QEMU with -nic none.
# CONFIG_WLAN is not set
# CONFIG_ETHERNET is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_HID is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_I2C is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_MEDIA_SUPPORT is not set

# No display: the console is ttyS0 and the page draws the terminal.
# CONFIG_FB is not set
# CONFIG_DRM is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_LOGO is not set

# No disks, so no disk filesystems; the root is the initramfs and the
# store arrives over 9p.
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NFS_FS is not set

# Tracing and debug machinery nothing here reads.
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_DEBUG_KERNEL is not set

# The vendored config is a defconfig for a real multiprocessor machine,
# and the pieces below all cost time in an emulator that executes every
# instruction. The machine here is one CPU with no power management and
# no second core to race against.

# EXPERT selects DEBUG_KERNEL, so the "# CONFIG_DEBUG_KERNEL is not set"
# above is silently overridden and DEBUG_PREEMPT rides in with it. That
# puts an out-of-line call and a check inside every preempt_disable,
# spin lock, rcu_read_lock and smp_processor_id in the kernel. Name it
# explicitly, which Kconfig does honour.
# CONFIG_DEBUG_PREEMPT is not set

# One vCPU, and the machine never passes -smp. A uniprocessor kernel
# turns preempt_disable into a barrier, drops the RCU read side to
# nothing (TINY_RCU), and collapses every spinlock.
# CONFIG_SMP is not set
# CONFIG_PREEMPT_DYNAMIC is not set
CONFIG_PREEMPT_NONE=y

# The timer interrupt fires 100 times a second whether or not anything
# is running, and each one is emulated. Stop it while the guest idles,
# which is most of the time a shell is waiting for a keystroke.
CONFIG_NO_HZ_IDLE=y

# Accounting and debug machinery nothing in this guest reads. NET_9P_DEBUG
# in particular adds a call to every 9p operation, and 9p is the one
# thing this guest does constantly.
# CONFIG_NET_9P_DEBUG is not set
# CONFIG_CGROUP_DEBUG is not set
# CONFIG_MEMCG is not set
# CONFIG_BLK_CGROUP is not set
# CONFIG_PERF_EVENTS is not set

# No firmware to talk to and no power states to enter: the vCPU runs
# when QEMU runs it.
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_X86_MCE is not set
# CONFIG_MICROCODE is not set

# Address-space randomisation buys nothing in a VM that is thrown away
# per tab, and five-level paging is page-table walking the guest never
# needs with 512 MB of RAM.
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_X86_5LEVEL is not set

# Put the VM event counters back. The vendored config turns them off,
# which costs a couple of per-CPU counters and takes /proc/vmstat's
# pgfault, pgmajfault and pgpgin with them — the numbers that say
# whether a slow first run is reading the store or faulting it in. A
# guest whose whole reason to exist is running someone else's binary
# for the first time should be able to answer that question.
CONFIG_VM_EVENT_COUNTERS=y

# The entropy source the machine actually has. Without a driver for it
# the pool starts empty, and the first program to ask for randomness
# drives the kernel's TSC-jitter loop instead — which cost a first run
# fifteen seconds (docs/performance.md). The device is virtio-rng-pci,
# fed by QEMU from the browser's crypto.getRandomValues.
CONFIG_HW_RANDOM_VIRTIO=y
