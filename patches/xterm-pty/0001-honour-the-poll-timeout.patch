     $PTY_pollTimeout: 0,
 
+    // The timeout the caller of poll(2) actually asked for. emscripten's
+    // own poll implementation calls every stream's poll op with a
+    // hardcoded -1, so the TTY op below cannot see the deadline the
+    // caller computed and would sleep until a keystroke arrived,
+    // ignoring its timers. Recorded on the way in and used instead.
+    $PTY_realPollTimeout: -1,
+
+    // And never sleep longer than this. Asking the TTY to wait throws,
+    // which abandons the scan of the caller's remaining descriptors, so
+    // one that becomes ready while the terminal is quiet is only noticed
+    // once poll returns. Returning early from poll is always allowed, so
+    // a cap costs nothing but keeps such an event from waiting on a
+    // keystroke that may never come. 10 ms rather than something larger
+    // because the boot handshake runs through this loop: at 50 ms it
+    // cost about 0.2 s of the boot, and at 10 ms it costs nothing
+    // measurable while the idle tab stays near a third of a core.
+    $PTY_maxPollSleep: 10,
+
     $PTY_askToWaitAgain__deps: ['$PTY_pollTimeout', '$FS'],
     $PTY_askToWaitAgain: (timeout) => {
         PTY_pollTimeout = timeout;
