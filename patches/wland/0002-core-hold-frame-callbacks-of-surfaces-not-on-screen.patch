diff --git a/core/src/compositor.zig b/core/src/compositor.zig
index 9c5bbb5..a687609 100644
--- a/core/src/compositor.zig
+++ b/core/src/compositor.zig
@@ -1561,9 +1561,10 @@ pub const Compositor = struct {
     /// WebSocket the relay intercepts wl_surface.frame and fires done
     /// itself, so that half is a no-op there — never both, or the app gets a
     /// fatal double done. Presentation feedback is the core's on every link.
-    /// A minimized or hidden window's callbacks are held until it is
-    /// restored or shown — on stream links only: the relay's own (WS) keep
-    /// their 16 ms pace.
+    /// A callback of a surface that is not on screen (surfaceShown: no
+    /// content, a role that is not shown, or a minimized or hidden window)
+    /// is held until it is, or dies with its surface — on stream links
+    /// only: the relay's own (WS) keep their 16 ms pace.
     pub fn tick(self: *Compositor, t: Tick) void {
         var it = self.conns.iterator();
         while (it.next()) |kv| {
@@ -1572,11 +1573,15 @@ pub const Compositor = struct {
             if (conn.feedbacks.items.len > 0) self.presentFeedbacks(conn_id, conn, t);
             var keep: usize = 0;
             for (conn.frame_callbacks.items) |cb| {
-                // a minimized (or hidden) window's surfaces are not
-                // repainted: their callbacks wait for the window to come
-                // back (the client's render loop stops, as on any
-                // compositor)
-                if (!cb.committed or underHidden(conn, cb.surface)) {
+                // a surface that is not on screen is not repainted: its
+                // callbacks wait for it to come back (the client's render
+                // loop stops, as on any compositor). That covers a
+                // minimized or hidden window, and a surface whose content
+                // went (attach(NULL)) or whose toplevel was destroyed:
+                // weston and wlroots fire no done for an unmapped surface,
+                // and SDL 3 can lose track of a frame callback whose
+                // listener points at a window it then frees
+                if (!cb.committed or !surfaceShown(conn, cb.surface)) {
                     conn.frame_callbacks.items[keep] = cb;
                     keep += 1;
                     continue;
@@ -6393,16 +6398,16 @@ test "wl_shm v2 release: destructor answers delete_id; a re-bind still works" {
