+        return;
+    }
+    struct wasm_lookup_entry *e = &wasm_lookup_cache[WASM_LOOKUP_HASH(pc)];
+    uint32_t epoch = qatomic_read(&wasm_lookup_epoch);
+#if WASM32_CENSUS
+    if (e->epoch == epoch && e->fidx == fidx && e->pc == pc && e->flags == flags) {
+        WASM_CENSUS_C(wasm_in_tci ? WCC_FILL_SAME_TCI : WCC_FILL_SAME);
+    } else if (e->epoch == epoch && e->fidx != 0) {
+        WASM_CENSUS_C(WCC_FILL_CONFLICT);
+    } else {
+        WASM_CENSUS_C(WCC_FILL_NEW);
+    }
+#endif
+    e->pc = pc;
+    e->flags = flags;
+    e->fidx = fidx;
+    e->hdr = (uint32_t)hdr;
+    e->epoch = epoch;
+#endif
+}
+
+/* Every entry of every vCPU's cache is stale from here on. */
+void wasm32_lookup_flush_all(void)
+{
+    WASM_CENSUS_C(WCC_EPOCH);
+    qatomic_inc(&wasm_lookup_epoch);
+}
+
+EM_JS(void, report_census_js, (double t, int gp, int gn, int cp, int cn), {
+        const g = Array.from(HEAPU32.subarray(gp >> 2, (gp >> 2) + gn));
+        const c = Array.from(HEAPU32.subarray(cp >> 2, (cp >> 2) + cn));
+        console.log("wasm32census t=" + t.toFixed(0) + " g=" + g.join(",") + " c=" + c.join(","));
+});
+
+/* One line of totals per burst of activity, printed when the vCPU halts. */
+void wasm32_census_idle(void)
+{
+#if WASM32_CENSUS
+    static __thread uint32_t last_total;
+    extern __thread struct wasmContext ctx;
+    uint32_t total = 0;
+    for (int i = 0; i < WC_N; i++) {
+        total += ctx.census[i];
+    }
+    for (int i = 0; i < WCC_N; i++) {
+        total += wasm_census_c[i];
+    }
+    if (total - last_total < WASM_CENSUS_REPORT_DELTA) {
+        return;
+    }
+    last_total = total;
+    report_census_js(emscripten_get_now(), (int)ctx.census, WC_N,
+                     (int)wasm_census_c, WCC_N);
+#endif
+}
