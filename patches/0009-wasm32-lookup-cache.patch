+ * The transition census. Generated code counts into ctx.census; the C
+ * paths below count into wasm_census_c. Both are printed together when
+ * the vCPU halts having moved by WASM_CENSUS_REPORT_DELTA since the
+ * last line (wasm32_census_idle), so a run shows up as a few lines.
+ */
+__thread uint32_t wasm_census_c[WCC_N];
+__thread int wasm_in_tci;
+#define WASM_CENSUS_REPORT_DELTA 2000
+
+/*
+ * The goto_ptr lookup cache (struct wasm_lookup_entry in wasm32.h).
+ * One table per vCPU thread; one epoch for all of them, so a flush from
+ * any thread (tcg_flush_jmp_cache runs for a CPU from wherever the TLB
+ * flush or the invalidation happens) is one store.
+ */
+uint32_t wasm_lookup_epoch = 1;
+__thread struct wasm_lookup_entry *wasm_lookup_cache;
+extern __thread int cur_core_num;
+const void *wasm_lookup_helper = (const void *)helper_lookup_tb_ptr;
+const uint32_t wasm_lookup_off_eip = offsetof(CPUArchState, eip);
+const uint32_t wasm_lookup_off_eflags = offsetof(CPUArchState, eflags);
+const uint32_t wasm_lookup_off_hflags = offsetof(CPUArchState, hflags);
+const uint32_t wasm_lookup_cs64_mask = HF_CS64_MASK;
+const uint32_t wasm_lookup_flags_mask = IOPL_MASK | TF_MASK | RF_MASK | VM_MASK | AC_MASK;
+
+/*
+ * Called by helper_lookup_tb_ptr with the block it found: remember its
+ * compiled function under the state that found it, so the next probe of
+ * that state from generated code skips the helper. Only 64-bit code is
+ * cached, because the probe keys on eip alone (cs_base is 0 there), and
+ * only compiled blocks, because the probe has nothing to call otherwise.
+ */
+void wasm32_lookup_fill(TranslationBlock *tb, uint64_t pc, uint32_t flags)
+{
+#if WASM32_LOOKUP_CACHE
+    if (!(flags & HF_CS64_MASK)) {
+        WASM_CENSUS_C(WCC_FILL_NOT64);
+        return;
+    }
+    struct wasm_tb_hdr *hdr = (struct wasm_tb_hdr *)tb->tc.ptr;
+    uint32_t fidx = hdr->fidx[cur_core_num];
+    if (fidx == 0) {
