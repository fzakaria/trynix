+/*
+ * Hooks from the accelerator into the wasm32 backend, for the
+ * block-transition investigation: a goto_ptr lookup cache read by
+ * generated code, and a census of transition kinds. Both are build
+ * variants selected in tcg/wasm32.h.
+ */
+#ifndef TCG_WASM32_HOOKS_H
+#define TCG_WASM32_HOOKS_H
+
+#include <stdint.h>
+
+/*
+ * Build variants. WASM32_CENSUS counts every kind of block transition
+ * (generated code increments ctx.census, C code wasm_census_c) and
+ * prints the totals when the vCPU halts. WASM32_LOOKUP_CACHE puts a
+ * direct-mapped cache from guest state to compiled function in front
+ * of every helper_lookup_tb_ptr call in generated code.
+ */
+#define WASM32_CENSUS 0
+#define WASM32_LOOKUP_CACHE 1
+
+/* Counters kept by C code (the dispatcher, the interpreter, cpu-exec). */
+enum {
+    WCC_EXEC_ENTRY,        /* tcg_qemu_tb_exec calls from cpu_exec */
+    WCC_DISPATCH_CALL,     /* compiled functions entered by the dispatcher */
+    WCC_TCI_RUN,           /* interpreter entries */
+    WCC_TCI_GOTO_TB_STAY,  /* interpreter followed a goto_tb without leaving */
+    WCC_TCI_GOTO_PTR_STAY, /* interpreter followed a goto_ptr without leaving */
+    WCC_TCI_TO_COMPILED,   /* interpreter handed a compiled successor to the dispatcher */
+    WCC_TCI_EXIT,          /* interpreter left through exit_tb or a NULL goto_ptr */
+    WCC_LOOKUP_HELPER,     /* helper_lookup_tb_ptr from compiled code */
+    WCC_LOOKUP_HELPER_TCI, /* helper_lookup_tb_ptr from the interpreter (ffi) */
+    WCC_LOOKUP_JC_HIT,     /* tb_lookup: QEMU jump cache hit */
+    WCC_LOOKUP_HTABLE,     /* tb_lookup: jump cache miss, hash table found it */
+    WCC_LOOKUP_NULL,       /* tb_lookup: no block */
+    WCC_LOOP_LOOKUP,       /* cpu_exec loop iterations (each looks a block up) */
+    WCC_TB_GEN,            /* blocks translated */
+    WCC_TB_ADD_JUMP,       /* direct jumps linked by cpu_exec */
+    WCC_EXIT_ZERO,         /* tcg_qemu_tb_exec returned 0 */
+    WCC_EXIT_UNLINKED,     /* returned a block with jump index 0 or 1 */
+    WCC_EXIT_REQUESTED,    /* returned TB_EXIT_REQUESTED */
+    WCC_JC_FLUSH,          /* tcg_flush_jmp_cache calls */
+    WCC_TB_INVAL,          /* tb_jmp_cache_inval_tb calls */
+    WCC_FILL_NEW,          /* lookup cache: entry filled (empty or stale) */
+    WCC_FILL_CONFLICT,     /* lookup cache: a live entry overwritten */
+    WCC_FILL_SAME,         /* lookup cache: entry already held this block */
+    WCC_FILL_SAME_TCI,     /* ... and the caller was the interpreter */
+    WCC_FILL_UNCOMPILED,   /* lookup cache: target has no function yet */
+    WCC_FILL_NOT64,        /* lookup cache: not 64-bit code, never probed */
+    WCC_EPOCH,             /* lookup cache invalidations (epoch bumps) */
+    WCC_N
+};
+
+extern __thread uint32_t wasm_census_c[WCC_N];
+extern __thread int wasm_in_tci;
+#if WASM32_CENSUS
+#define WASM_CENSUS_C(i) (wasm_census_c[i]++)
+#else
+#define WASM_CENSUS_C(i) ((void)0)
+#endif
+
+struct TranslationBlock;
+void wasm32_lookup_fill(struct TranslationBlock *tb, uint64_t pc, uint32_t flags);
+void wasm32_lookup_flush_all(void);
+void wasm32_census_idle(void);
+
+#endif
