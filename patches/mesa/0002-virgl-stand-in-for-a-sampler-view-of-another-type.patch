-/* A 1x1 texture with the target, format and sample count of `like`, kept
- * by the context for stand-in views.
+/* Put (0, 0, 0, 1), the texel GLES samples from an incomplete texture, in
+ * every layer of a new stand-in texture of a pure integer format.
+ *
+ * Mesa puts an RGBA8 texture of that texel on the unit of a sampler whose
+ * texture is incomplete or missing, and an integer sampler on such a unit
+ * gets an integer stand-in (virgl_standin_wanted), which has to read the
+ * same. A multisample texture cannot be written by a transfer, and stays
+ * as the host made it.
+ */
+static void
+virgl_fill_opaque_black(struct virgl_context *vctx, struct pipe_resource *tex)
+{
+   static const uint32_t opaque_black[4] = { 0, 0, 0, 1 };
+   uint32_t texels[PIPE_TEX_FACE_MAX][4];
+   struct pipe_box box;
+
+   if (!util_format_is_pure_integer(tex->format) || tex->nr_samples > 1) {
+      return;
+   }
+
+   for (unsigned layer = 0; layer < tex->array_size; layer++) {
+      util_format_pack_rgba(tex->format, texels[layer], opaque_black, 1);
+   }
+
+   u_box_3d(0, 0, 0, 1, 1, tex->array_size, &box);
+   vctx->base.texture_subdata(&vctx->base, tex, 0, PIPE_MAP_WRITE, &box,
+                              texels, sizeof(texels[0]), sizeof(texels[0]));
+}
