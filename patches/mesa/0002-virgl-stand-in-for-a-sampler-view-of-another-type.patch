-/* A 1x1 texture with the target, format and sample count of `like`, kept
- * by the context for stand-in views.
+/* The type a sampler has to return to sample a texture of `format` on a
+ * host that checks it, as WebGL 2 does: SINT or UINT for a pure integer
+ * format, FLOAT for any other.
+ */
+static enum tgsi_return_type
+virgl_format_return_type(enum pipe_format format)
+{
+   if (util_format_is_pure_sint(format))
+      return TGSI_RETURN_TYPE_SINT;
+   if (util_format_is_pure_uint(format))
+      return TGSI_RETURN_TYPE_UINT;
+   return TGSI_RETURN_TYPE_FLOAT;
+}
+
+/* A format a sampler returning `type` can sample on such a host. */
+static enum pipe_format
+virgl_return_type_format(enum tgsi_return_type type)
+{
+   switch (type) {
+   case TGSI_RETURN_TYPE_SINT:
+      return PIPE_FORMAT_R8G8B8A8_SINT;
+   case TGSI_RETURN_TYPE_UINT:
+      return PIPE_FORMAT_R8G8B8A8_UINT;
+   default:
+      return PIPE_FORMAT_R8G8B8A8_UNORM;
+   }
+}
+
+/* The format of a stand-in the host should sample in place of `view`, in
+ * slot `slot` of a stage running `shader`, or PIPE_FORMAT_NONE when the
+ * host can sample the view itself.
+ *
+ * A sampler whose texture has another type (an integer texture on a float
+ * sampler, or the other way round) gets a texture of the sampler's type.
+ * The texture's own format is compared rather than the view's: a host
+ * without texture views, as a GLES 3.0 one, samples the texture's format.
+ * A view in a feedback loop gets a texture like its own.
+ */
+static enum pipe_format
+virgl_standin_format(const struct virgl_context *vctx,
+                     const struct virgl_shader_state *shader,
+                     unsigned slot,
+                     const struct pipe_sampler_view *view)
+{
+   if (!view || !view->texture || view->target == PIPE_BUFFER)
+      return PIPE_FORMAT_NONE;
+
+   if (shader && (shader->sampler_views_declared & (1u << slot))) {
+      const enum tgsi_return_type type =
+         shader->sampler_type[slot] == TGSI_RETURN_TYPE_SINT ||
+         shader->sampler_type[slot] == TGSI_RETURN_TYPE_UINT ?
+            shader->sampler_type[slot] : TGSI_RETURN_TYPE_FLOAT;
+      if (virgl_format_return_type(view->texture->format) != type)
+         return virgl_return_type_format(type);
+   }
+
+   if (virgl_view_in_framebuffer(&vctx->framebuffer.base, view))
+      return view->texture->format;
+
+   return PIPE_FORMAT_NONE;
+}
+
+/* A 1x1 texture of `format` with the target and sample count of `like`,
+ * kept by the context for stand-in views.
  */
 static struct pipe_resource *
 virgl_feedback_texture(struct virgl_context *vctx,
-                       const struct pipe_resource *like)
+                       const struct pipe_resource *like,
+                       enum pipe_format format)
 {
    struct pipe_screen *screen = vctx->base.screen;
 
    for (unsigned i = 0; i < VIRGL_FEEDBACK_TEXTURES; i++) {
       struct pipe_resource *tex = vctx->feedback_textures[i];
-      if (tex && tex->target == like->target && tex->format == like->format &&
+      if (tex && tex->target == like->target && tex->format == format &&
           tex->nr_samples == like->nr_samples)
          return tex;
    }
@@ -1067,7 +1149,7 @@ virgl_feedback_texture(struct virgl_context *vctx,
                      like->target == PIPE_TEXTURE_CUBE_ARRAY;
    const struct pipe_resource templ = {
       .target = like->target,
-      .format = like->format,
+      .format = format,
       .width0 = 1,
       .height0 = 1,
       .depth0 = 1,
@@ -1086,18 +1168,22 @@ virgl_feedback_texture(struct virgl_context *vctx,
    return tex;
 }
 
-/* A view like `view` (target, formats, swizzle) of a 1x1 texture that no
- * framebuffer holds.
+/* A view like `view` (target, swizzle, and format unless `format` is
+ * another texture format than the view's texture has) of a 1x1 texture
+ * of `format` that no framebuffer holds.
  */
 static struct pipe_sampler_view *
 virgl_feedback_standin(struct virgl_context *vctx,
-                       const struct pipe_sampler_view *view)
+                       const struct pipe_sampler_view *view,
+                       enum pipe_format format)
 {
-   struct pipe_resource *tex = virgl_feedback_texture(vctx, view->texture);
+   struct pipe_resource *tex = virgl_feedback_texture(vctx, view->texture, format);
    if (!tex)
       return NULL;
 
    struct pipe_sampler_view templ = *view;
+   if (format != view->texture->format)
+      templ.format = format;
    templ.u.tex.first_level = 0;
    templ.u.tex.last_level = 0;
    templ.u.tex.last_layer = MIN2(view->u.tex.last_layer - view->u.tex.first_layer,
@@ -1107,22 +1193,23 @@ virgl_feedback_standin(struct virgl_context *vctx,
 }
 
 /* Give the host a stand-in for every sampler view of a graphics stage that
- * forms a feedback loop with the framebuffer, and the real view back once
- * it no longer does.
+ * forms a feedback loop with the framebuffer or has a type the stage's
+ * shader cannot sample it with, and the real view back once it no longer
+ * does (virgl_standin_format).
  *
  * GL leaves what such a draw samples undefined. WebGL 2 refuses the draw
  * with INVALID_OPERATION, which a virglrenderer that replays GLES on WebGL
  * (unkernel's) takes as a context error, after which it refuses every
- * later draw of the context. A stand-in of the same target and formats
- * keeps the shader's sampler types matched on the host and puts a texture
- * that is not attached on that unit; an unbound slot would not, because
- * the host leaves a texture unit with no view as it was.
+ * later draw of the context. A stand-in of the same target keeps the
+ * shader's sampler targets matched on the host and puts on that unit a
+ * texture that is not attached and that the sampler's type can sample; an
+ * unbound slot would not, because the host leaves a texture unit with no
+ * view as it was.
  */
 static void
 virgl_hide_feedback_views(struct virgl_context *vctx)
 {
    struct virgl_winsys *vws = virgl_screen(vctx->base.screen)->vws;
-   const struct pipe_framebuffer_state *fb = &vctx->framebuffer.base;
 
    if (!vctx->feedback_dirty)
       return;
@@ -1130,20 +1217,27 @@ virgl_hide_feedback_views(struct virgl_context *vctx)
 
    for (int stage = MESA_SHADER_VERTEX; stage <= MESA_SHADER_FRAGMENT; stage++) {
       struct virgl_shader_binding_state *binding = &vctx->shader_bindings[stage];
+      const struct virgl_shader_state *shader = vctx->bound_shaders[stage];
 
       for (unsigned i = 0; i < PIPE_MAX_SAMPLERS; i++) {
          struct pipe_sampler_view *view = binding->views[i];
-         const bool loop = virgl_view_in_framebuffer(fb, view);
-
-         /* The host already holds the stand-in or the real view as needed. */
-         if (loop == (binding->feedback_standins[i] != NULL))
+         const struct pipe_sampler_view *held = binding->feedback_standins[i];
+         const enum pipe_format format = virgl_standin_format(vctx, shader, i, view);
+
+         /* The host already holds the real view, or a stand-in of the
+          * format needed.
+          */
+         if (format == PIPE_FORMAT_NONE ? !held :
+             held && held->texture->format == format)
             continue;
 
-         if (loop) {
-            struct pipe_sampler_view *standin = virgl_feedback_standin(vctx, view);
+         if (format != PIPE_FORMAT_NONE) {
+            struct pipe_sampler_view *standin =
+               virgl_feedback_standin(vctx, view, format);
             if (!standin)
                continue;
 
+            pipe_sampler_view_reference(&binding->feedback_standins[i], NULL);
             binding->feedback_standins[i] = standin;
             vws->emit_res(vws, vctx->cbuf,
                           virgl_resource(standin->texture)->hw_res, false);
