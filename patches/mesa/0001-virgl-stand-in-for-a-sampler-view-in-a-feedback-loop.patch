Subject: [PATCH] virgl: stand in for a sampler view in a feedback loop

trynix carries this patch for unkernel's GL renderer, and it can go
once unkernel's vrend stops passing such bindings to WebGL, which is
what pithings/unkernel#27 asks for.

A draw that renders into a level of a texture that a sampler of the
draw reads is a rendering feedback loop, and GL and GLES leave the
values it samples undefined. The sampler reads the base level alone
with a filter without mipmaps, and the levels from the base to the max
with a mipmap filter (OpenGL ES 3.0, section 4.4.3.1). WebGL 2 refuses
such a draw with INVALID_OPERATION, even when the shader never takes
the branch that samples the texture. unkernel's virglrenderer replays
the guest's GL on the page's WebGL 2 and checks GL errors once per
command buffer, so one refused draw puts the guest's context in error,
and every later draw in it fails. Firefox's WebRender leaves an input
texture on a unit and then renders into that texture, so Firefox in
the guest goes blank after a while.

Before a draw, each sampler view of a graphics stage whose texture is
attached to the framebuffer at a level inside the view's levels is
replaced on the host by a stand-in. When the lowest attached level is
above the view's first level, the stand-in is a view of the same
texture whose levels end below the attached one. It keeps the first
level, which a filter without mipmaps reads, with its contents; with a
mipmap filter the draw is a loop in GL, whose values are undefined.
vrend on a host without texture views, as WebGL 2 is, sets a view's
first and last level as the texture's GL_TEXTURE_BASE_LEVEL and
GL_TEXTURE_MAX_LEVEL when it binds the view, and WebGL 2 looks for the
loop no further than those. When the view's first level is attached,
every filter reads it, and the stand-in is a view of a 1x1 texture
with the same target, formats and swizzle. The real view goes back at
the first draw after the framebuffer or the views change. Only values
GL leaves undefined change. An unbound slot would not do: vrend leaves
a texture unit with no view as it was, with the attached texture still
on it.

Not covered: a blit or copy whose source and destination are the same
image, which WebGL refuses too; and a shader that asks how many levels
a texture has (textureQueryLevels) while rendering into one of them,
which counts the stand-in's levels.

---
diff --git a/src/gallium/drivers/virgl/virgl_context.c b/src/gallium/drivers/virgl/virgl_context.c
index bfc9835..fde0cac 100644
--- a/src/gallium/drivers/virgl/virgl_context.c
+++ b/src/gallium/drivers/virgl/virgl_context.c
@@ -205,6 +205,14 @@ static void virgl_attach_res_sampler_views(struct virgl_context *vctx,
          vws->emit_res(vws, vctx->cbuf, res->hw_res, false);
       }
    }
+
+   for (int i = 0; i < PIPE_MAX_SAMPLERS; ++i) {
+      if (binding->feedback_standins[i]) {
+         struct virgl_resource *res =
+            virgl_resource(binding->feedback_standins[i]->texture);
+         vws->emit_res(vws, vctx->cbuf, res->hw_res, false);
+      }
+   }
 }
 
 static void virgl_attach_res_vertex_buffers(struct virgl_context *vctx)
@@ -505,6 +513,7 @@ static void virgl_set_framebuffer_state(struct pipe_context *ctx,
    util_copy_framebuffer_state(pframebuffer, state);
    virgl_encoder_set_framebuffer_state(vctx, pframebuffer);
    virgl_attach_res_framebuffer(vctx);
+   vctx->feedback_dirty = true;
 }
 
 static void virgl_set_viewport_states(struct pipe_context *ctx,
@@ -1008,6 +1017,251 @@ static void virgl_clear_texture(struct pipe_context *ctx,
    virgl_resource_dirty(vres, level);
 }
 
+/* What virgl_attached_level returns for a view none of whose levels the
+ * framebuffer holds.
+ */
+#define VIRGL_NO_LEVEL UINT_MAX
+
+/* The level of the view's texture that a framebuffer surface holds, if the
+ * view covers it, or VIRGL_NO_LEVEL. GL calls a draw with such a surface a
+ * rendering feedback loop whatever the layers, so layers are not compared.
+ */
+static unsigned
+virgl_surface_level_in_view(const struct pipe_surface *surf,
+                            const struct pipe_sampler_view *view)
+{
+   if (surf->texture != view->texture ||
+       surf->level < view->u.tex.first_level ||
+       surf->level > view->u.tex.last_level) {
+      return VIRGL_NO_LEVEL;
+   }
+
+   return surf->level;
+}
+
+/* The lowest level of the view's texture that the framebuffer holds among
+ * the levels the view covers, or VIRGL_NO_LEVEL when it holds none of them.
+ */
+static unsigned
+virgl_attached_level(const struct pipe_framebuffer_state *fb,
+                     const struct pipe_sampler_view *view)
+{
+   if (!view || !view->texture || view->target == PIPE_BUFFER) {
+      return VIRGL_NO_LEVEL;
+   }
+
+   unsigned lowest = virgl_surface_level_in_view(&fb->zsbuf, view);
+   for (unsigned i = 0; i < fb->nr_cbufs; i++) {
+      lowest = MIN2(lowest, virgl_surface_level_in_view(&fb->cbufs[i], view));
+   }
+
+   return lowest;
+}
+
+/* What the host samples in a slot in place of the guest's sampler view
+ * (virgl_hide_feedback_views).
+ */
+enum virgl_standin_kind {
+   /* The guest's view itself. */
+   VIRGL_STANDIN_NONE,
+
+   /* A view like the guest's of the same texture, whose levels end below
+    * the lowest one the framebuffer holds.
+    */
+   VIRGL_STANDIN_LEVELS,
+
+   /* A view like the guest's of a 1x1 texture that no framebuffer holds. */
+   VIRGL_STANDIN_TEXTURE,
+};
+
+struct virgl_standin {
+   enum virgl_standin_kind kind;
+
+   /* The last level a VIRGL_STANDIN_LEVELS view keeps. */
+   unsigned last_level;
+};
+
+/* The stand-in the host should sample in place of `view`.
+ *
+ * A view whose levels hold an attachment of the framebuffer forms a
+ * rendering feedback loop with it, which WebGL 2 refuses. When the lowest
+ * attached level is above the view's first one, the stand-in is the view
+ * with its levels cut below that attached level: a filter without mipmaps
+ * reads the first level alone, which keeps its contents, and with a
+ * mipmap filter GL calls the draw a loop, whose values are undefined. A
+ * host without texture views, as a GLES one, takes the view's levels as
+ * the texture's base and max level, which are what WebGL 2 checks for the
+ * loop. When the first level itself is attached, every filter reads it,
+ * and the stand-in is a 1x1 texture.
+ */
+static struct virgl_standin
+virgl_standin_wanted(const struct virgl_context *vctx,
+                     const struct pipe_sampler_view *view)
+{
+   const unsigned attached = virgl_attached_level(&vctx->framebuffer.base, view);
+
+   if (attached == VIRGL_NO_LEVEL) {
+      return (struct virgl_standin){ .kind = VIRGL_STANDIN_NONE };
+   }
+
+   if (attached > view->u.tex.first_level) {
+      return (struct virgl_standin){
+         .kind = VIRGL_STANDIN_LEVELS,
+         .last_level = attached - 1,
+      };
+   }
+
+   return (struct virgl_standin){ .kind = VIRGL_STANDIN_TEXTURE };
+}
+
+/* Whether `held`, the stand-in the host holds in place of `view` or NULL
+ * for none, is the one `want` asks for.
+ */
+static bool
+virgl_standin_held(const struct pipe_sampler_view *held,
+                   const struct pipe_sampler_view *view,
+                   const struct virgl_standin *want)
+{
+   switch (want->kind) {
+   case VIRGL_STANDIN_LEVELS:
+      return held && held->texture == view->texture &&
+             held->u.tex.last_level == want->last_level;
+   case VIRGL_STANDIN_TEXTURE:
+      return held && held->texture != view->texture;
+   default:
+      return !held;
+   }
+}
+
+/* A 1x1 texture with the target, format and sample count of `like`, kept
+ * by the context for stand-in views.
+ */
+static struct pipe_resource *
+virgl_feedback_texture(struct virgl_context *vctx,
+                       const struct pipe_resource *like)
+{
+   struct pipe_screen *screen = vctx->base.screen;
+
+   for (unsigned i = 0; i < VIRGL_FEEDBACK_TEXTURES; i++) {
+      struct pipe_resource *tex = vctx->feedback_textures[i];
+      if (tex && tex->target == like->target && tex->format == like->format &&
+          tex->nr_samples == like->nr_samples) {
+         return tex;
+      }
+   }
+
+   const bool cube = like->target == PIPE_TEXTURE_CUBE ||
+                     like->target == PIPE_TEXTURE_CUBE_ARRAY;
+   const struct pipe_resource templ = {
+      .target = like->target,
+      .format = like->format,
+      .width0 = 1,
+      .height0 = 1,
+      .depth0 = 1,
+      .array_size = cube ? PIPE_TEX_FACE_MAX : 1,
+      .nr_samples = like->nr_samples,
+      .nr_storage_samples = like->nr_storage_samples,
+      .bind = PIPE_BIND_SAMPLER_VIEW,
+   };
+   struct pipe_resource *tex = screen->resource_create(screen, &templ);
+   if (!tex) {
+      return NULL;
+   }
+
+   unsigned slot = vctx->feedback_next_texture++ % VIRGL_FEEDBACK_TEXTURES;
+   pipe_resource_reference(&vctx->feedback_textures[slot], NULL);
+   vctx->feedback_textures[slot] = tex;
+   return tex;
+}
+
+/* The stand-in `want` asks for in place of `view`: a view like `view`
+ * (target, formats, swizzle) of its own texture with fewer levels, or of a
+ * 1x1 texture that no framebuffer holds.
+ */
+static struct pipe_sampler_view *
+virgl_feedback_standin(struct virgl_context *vctx,
+                       const struct pipe_sampler_view *view,
+                       const struct virgl_standin *want)
+{
+   struct pipe_sampler_view templ = *view;
+
+   if (want->kind == VIRGL_STANDIN_LEVELS) {
+      templ.u.tex.last_level = want->last_level;
+      return vctx->base.create_sampler_view(&vctx->base, view->texture, &templ);
+   }
+
+   struct pipe_resource *tex = virgl_feedback_texture(vctx, view->texture);
+   if (!tex) {
+      return NULL;
+   }
+
+   templ.u.tex.first_level = 0;
+   templ.u.tex.last_level = 0;
+   templ.u.tex.last_layer = MIN2(view->u.tex.last_layer - view->u.tex.first_layer,
+                                 tex->array_size - 1);
+   templ.u.tex.first_layer = 0;
+   return vctx->base.create_sampler_view(&vctx->base, tex, &templ);
+}
+
+/* Give the host a stand-in for every sampler view of a graphics stage that
+ * forms a feedback loop with the framebuffer, and the real view back once
+ * it no longer does (virgl_standin_wanted).
+ *
+ * WebGL 2 refuses a draw with such a view with INVALID_OPERATION, even
+ * when the shader never samples it, which a virglrenderer that replays
+ * GLES on WebGL (unkernel's) takes as a context error, after which it
+ * refuses every later draw of the context. A stand-in of the same target
+ * and formats keeps the shader's sampler types matched on the host and
+ * puts on that unit levels that are not attached; an unbound slot would
+ * not, because the host leaves a texture unit with no view as it was.
+ */
+static void
+virgl_hide_feedback_views(struct virgl_context *vctx)
+{
+   struct virgl_winsys *vws = virgl_screen(vctx->base.screen)->vws;
+
+   if (!vctx->feedback_dirty) {
+      return;
+   }
+   vctx->feedback_dirty = false;
+
+   for (int stage = MESA_SHADER_VERTEX; stage <= MESA_SHADER_FRAGMENT; stage++) {
+      struct virgl_shader_binding_state *binding = &vctx->shader_bindings[stage];
+
+      for (unsigned i = 0; i < PIPE_MAX_SAMPLERS; i++) {
+         struct pipe_sampler_view *view = binding->views[i];
+         const struct virgl_standin want = virgl_standin_wanted(vctx, view);
+
+         /* The host already holds the real view or the stand-in needed. */
+         if (virgl_standin_held(binding->feedback_standins[i], view, &want)) {
+            continue;
+         }
+
+         /* A new stand-in, in place of the real view or an old stand-in. */
+         if (want.kind != VIRGL_STANDIN_NONE) {
+            struct pipe_sampler_view *standin =
+               virgl_feedback_standin(vctx, view, &want);
+            if (!standin) {
+               continue;
+            }
+
+            pipe_sampler_view_reference(&binding->feedback_standins[i], NULL);
+            binding->feedback_standins[i] = standin;
+            vws->emit_res(vws, vctx->cbuf,
+                          virgl_resource(standin->texture)->hw_res, false);
+            virgl_encode_set_sampler_views(vctx, stage, i, 1,
+                                           (struct virgl_sampler_view **)&standin);
+            continue;
+         }
+
+         /* The real view back. */
+         virgl_encode_set_sampler_views(vctx, stage, i, 1,
+                                        (struct virgl_sampler_view **)&binding->views[i]);
+         pipe_sampler_view_reference(&binding->feedback_standins[i], NULL);
+      }
+   }
+}
+
 static void virgl_draw_vbo(struct pipe_context *ctx,
                            const struct pipe_draw_info *dinfo,
                            unsigned drawid_offset,
@@ -1055,6 +1309,11 @@ static void virgl_draw_vbo(struct pipe_context *ctx,
            virgl_hw_set_index_buffer(vctx, &ib);
    }
 
+   /* Before the resources are emitted: a flush while encoding the
+    * stand-ins starts a command buffer, and the draw emits them again.
+    */
+   virgl_hide_feedback_views(vctx);
+
    if (!vctx->num_draws)
       virgl_reemit_draw_resources(vctx);
    vctx->num_draws++;
@@ -1182,6 +1441,11 @@ static void virgl_set_sampler_views(struct pipe_context *ctx,
 
    virgl_encode_set_sampler_views(vctx, shader_type,
          start_slot, num_views, (struct virgl_sampler_view **)binding->views);
+
+   for (unsigned i = start_slot; i < MIN2(start_slot + num_views, PIPE_MAX_SAMPLERS); i++)
+      pipe_sampler_view_reference(&binding->feedback_standins[i], NULL);
+   vctx->feedback_dirty = true;
+
    virgl_attach_res_sampler_views(vctx, shader_type);
 
    if (unbind_num_trailing_slots) {
@@ -1571,6 +1835,9 @@ virgl_release_shader_binding(struct virgl_context *vctx,
       }
    }
 
+   for (int i = 0; i < PIPE_MAX_SAMPLERS; ++i)
+      pipe_sampler_view_reference(&binding->feedback_standins[i], NULL);
+
    while (binding->ubo_enabled_mask) {
       int i = u_bit_scan(&binding->ubo_enabled_mask);
       pipe_resource_reference(&binding->ubos[i].buffer, NULL);
@@ -1618,6 +1885,9 @@ virgl_context_destroy( struct pipe_context *ctx )
    for (shader_type = 0; shader_type < MESA_SHADER_STAGES; shader_type++)
       virgl_release_shader_binding(vctx, shader_type);
 
+   for (unsigned i = 0; i < VIRGL_FEEDBACK_TEXTURES; i++)
+      pipe_resource_reference(&vctx->feedback_textures[i], NULL);
+
    while (vctx->atomic_buffer_enabled_mask) {
       int i = u_bit_scan(&vctx->atomic_buffer_enabled_mask);
       pipe_resource_reference(&vctx->atomic_buffers[i].buffer, NULL);
diff --git a/src/gallium/drivers/virgl/virgl_context.h b/src/gallium/drivers/virgl/virgl_context.h
index 3ce8228..481cf0f 100644
--- a/src/gallium/drivers/virgl/virgl_context.h
+++ b/src/gallium/drivers/virgl/virgl_context.h
@@ -56,6 +56,11 @@ struct virgl_rasterizer_state {
 struct virgl_shader_binding_state {
    struct pipe_sampler_view *views[PIPE_MAX_SHADER_SAMPLER_VIEWS];
 
+   /* Stand-ins the host holds in place of views[i] while views[i] forms a
+    * feedback loop with the framebuffer (virgl_hide_feedback_views).
+    */
+   struct pipe_sampler_view *feedback_standins[PIPE_MAX_SAMPLERS];
+
    struct pipe_constant_buffer ubos[PIPE_MAX_CONSTANT_BUFFERS];
    uint32_t ubo_enabled_mask;
 
@@ -77,6 +82,9 @@ struct virgl_framebuffer_state
    uint32_t zsbuf_handle;
 };
 
+/* How many stand-in textures a context keeps for feedback loops. */
+#define VIRGL_FEEDBACK_TEXTURES 8
+
 struct virgl_context {
    struct pipe_context base;
    struct virgl_cmd_buf *cbuf;
@@ -113,6 +121,17 @@ struct virgl_context {
 
    /* The total size of staging resources used in queued copy transfers. */
    uint64_t queued_staging_res_size;
+
+   /* Set when the framebuffer or a sampler view changes, so that the next
+    * draw looks for feedback loops again.
+    */
+   bool feedback_dirty;
+
+   /* 1x1 textures the feedback stand-ins view, one per target, format and
+    * sample count, replaced in turn when all are taken.
+    */
+   struct pipe_resource *feedback_textures[VIRGL_FEEDBACK_TEXTURES];
+   unsigned feedback_next_texture;
 };
 
 struct virgl_vertex_elements_state {
